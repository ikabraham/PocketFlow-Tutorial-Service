# LLM. Required.
GEMINI_API_KEY=

# GitHub. Optional for public repos, but avoids rate limits.
GITHUB_TOKEN=

# The URL the outside world uses. The container constructs its own
# tutorial_url from this; the MCP passes it through untouched.
PUBLIC_BASE_URL=https://toolservice.abrahamtech.com/tutorials

# Abort a job that runs longer than this, in seconds.
JOB_TIMEOUT=3600
